# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
# Todo el sistema usa un cliente compatible con la API de OpenAI: para cambiar de proveedor solo cambian estas variables.

# --- Opción 1 (recomendada): Groq, gratis con registro y con tool calling nativo (usada para los resultados en results/) ---
# Clave en https://console.groq.com/keys. Un agente hace varias llamadas por mensaje: los endpoints gratuitos
# de OpenRouter (50 llamadas/día) no alcanzan, Groq sí.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_tu_clave_aqui
# Router, pedidos y RAG: Qwen 3.8 27B, el mismo modelo con el que se validaron los prompts del Taller 1
LLM_MODEL=qwen/qwen3.8-27b
LLM_PAUSA_SEG=0

# --- Agente: un modelo propio, el más fiable con herramientas (si no se define, el agente usa LLM_*) ---
AGENTE_MODEL=openai/gpt-oss-120b
# Respaldo si el modelo del agente falla (p. ej. se agota su cuota diaria de 200.000 tokens en Groq gratis).
# Cada modelo tiene su propia cuota. Vacío = sin respaldo.
AGENTE_MODELOS_RESPALDO=openai/gpt-oss-20b,qwen/qwen3.8-27b
# AGENTE_BASE_URL y AGENTE_API_KEY solo si el agente usa otro proveedor
# AGENTE_LIMITE_PASOS=12

# --- Opción 2: Qwen 100 % local con Ollama (sin clave; ejecuta antes: ollama pull qwen2.5:7b) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# --- Opción 3: OpenRouter (modelos :free, 20 llamadas/min y 50/día; usado en los Talleres 1 y 2) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-tu_clave_aqui
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_PAUSA_SEG=3.5

# --- Opción 4: OpenAI (de pago) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=tu_clave_de_openai
# LLM_MODEL=gpt-4o-mini

# --- Demostración del manejo de errores: hace fallar la API de la transportadora ---
# Valores: un nombre (EnvíaVerde, RutaExpress, Mensajería Andina), varios separados por coma, o "todas".
# SIMULAR_FALLA_TRANSPORTADORA=

# --- Parámetros del RAG (opcionales; estos son los valores por defecto) ---
# RAG_MODELO_EMBEDDINGS=intfloat/multilingual-e5-small
# RAG_K=4
# RAG_UMBRAL=0.80
# RAG_CHUNK_TAMANO=1000
# RAG_CHUNK_SOLAPE=80
